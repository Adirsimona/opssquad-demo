# FinTech Demo Environment Configuration

# =============================================================================
# OpsSquad Agent Configuration
# =============================================================================
# Get these from the OpsSquad dashboard for each service

OPSSQUAD_API_KEY=your-api-key-here

# Individual service agent IDs (optional - can use same ID for all)
API_GATEWAY_AGENT_ID=
AUTH_SERVICE_AGENT_ID=
ACCOUNT_SERVICE_AGENT_ID=
TRANSACTION_SERVICE_AGENT_ID=
FRAUD_SERVICE_AGENT_ID=
NOTIFICATION_SERVICE_AGENT_ID=
PAYMENT_SERVICE_AGENT_ID=

# =============================================================================
# Issue Simulation (override in docker-compose scenario files)
# =============================================================================

# Memory Leak Scenario
ENABLE_MEMORY_LEAK=false
MEMORY_LEAK_RATE_MB=5

# DB Connection Exhaustion Scenario
ENABLE_CONNECTION_LEAK=false
POSTGRES_MAX_CONNECTIONS=100

# Queue Backlog Scenario
ENABLE_SLOW_CONSUMER=false
CONSUMER_DELAY_MS=5000

# Cascade Timeout Scenario
ENABLE_CASCADE_TIMEOUT=false
ENABLE_SLOW_SCORING=false
ENABLE_SLOW_PAYMENTS=false
DOWNSTREAM_TIMEOUT_MS=5000
SCORING_DELAY_MS=8000
PAYMENT_DELAY_MS=10000

# Auth Failure Scenario
ENABLE_TOKEN_FAILURE=false
TOKEN_FAILURE_RATE=0.3
REDIS_MEMORY_LIMIT=128M

# Payment Slowdown Scenario
ENABLE_PAYMENT_FAILURES=false
PAYMENT_FAILURE_RATE=0.2
